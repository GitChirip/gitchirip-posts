---
params: [card: Card]
---
<article class="chirp" id="c<%= card.number %>" data-href="<%= card.href %>">
  <a class="portrait" href="<%= card.profileHref %>"><img class="avatar" src="<%= card.avatar %>" alt="" width="40" height="40" loading="lazy"></a>
  <div class="body">
    <header>
      <a class="name" href="<%= card.profileHref %>"><%= card.displayName %></a>
      <a class="handle" href="<%= card.profileHref %>">@<%= card.login %></a>
      <span class="dot">·</span>
      <a class="when" href="<%= card.href %>"><time datetime="<%= card.publishedAt %>"><%= card.publishedLabel %></time></a>
    </header>
    <% if !card.replyToHref.empty? %>
    <p class="context">Replying to <a href="<%= card.replyToHref %>">@<%= card.replyToLogin %></a></p>
    <% end %>
    <p class="text"><%== card.html %></p>
    <footer class="actions">
      <a class="action reply" href="<%= card.href %>" title="Reply">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 5.5h15v10.5H10l-5.5 4z" /></svg>
        <span><%= card.replies %></span>
      </a>
      <a class="action like likes" href="<%= card.pullUrl %>" target="_blank" rel="noopener" data-number="<%= card.number %>" title="Like it with a reaction on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.5s-7-4.3-8.8-8.3C2 8.4 3.8 5 7 5c2.1 0 3.6 1.3 5 3.2C13.4 6.3 14.9 5 17 5c3.2 0 5 3.4 3.8 6.2-1.8 4-8.8 8.3-8.8 8.3z" /></svg>
        <span class="count"><%= card.likes %></span>
      </a>
      <a class="action commit" href="<%= card.commitUrl %>" title="The commit">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M2.5 12h6M15.5 12h6" /></svg>
        <span><%= card.shortSha %></span>
      </a>
    </footer>
  </div>
</article>
