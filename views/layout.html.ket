---
params: [title: String, base: String, repository: String, people: String, content: Block<String>]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= base %>/assets/style.css">
    <script src="<%= base %>/assets/chirp.js" defer></script>
  </head>
  <body data-repository="<%= repository %>">
    <div class="app">
      <nav class="rail">
        <a class="logo" href="<%= base %>/" title="GitChirip">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1.5 12h5M17.5 12h5" /><circle cx="12" cy="12" r="5" /><path class="fill" d="M16.4 9.6 19.8 12l-3.4 2.4z" /></svg>
        </a>
        <a class="item" href="<%= base %>/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.8l8.5 6.7V20h-5.6v-6.2H9.1V20H3.5z" /></svg>
          <span>Home</span>
        </a>
        <a class="item" href="#about">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5.5M12 7.6v.1" /></svg>
          <span>About</span>
        </a>
        <a class="item" href="https://github.com/<%= repository %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5" /></svg>
          <span>Source</span>
        </a>
        <a class="pill post" href="<%= base %>/#compose"><span>Chirp</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></a>
      </nav>
      <main class="column">
<%== content() %>
      </main>
      <aside class="sidebar">
        <section class="panel" id="about">
          <h2>What is this?</h2>
          <p>A microblog built on git. Every chirp is a commit.</p>
          <a class="pill dark" href="https://github.com/<%= repository %>/fork">Fork to join</a>
        </section>
        <section class="panel">
          <h2>Who's chirping</h2>
<%== people %>
        </section>
        <p class="fineprint">No servers, no database: just <a href="https://github.com/<%= repository %>"><%= repository %></a>.</p>
      </aside>
    </div>
  </body>
</html>
