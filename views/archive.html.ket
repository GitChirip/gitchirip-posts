---
params: [name: String, subtitle: String, back: String, cards: String, older: String]
---
<header class="bar">
  <a class="back" href="<%= back %>" title="Back">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 5.5 4.5 12l6.5 6.5" /></svg>
  </a>
  <div>
    <h1><%= name %></h1>
    <p class="sub"><%= subtitle %></p>
  </div>
</header>
<section class="feed">
<%== cards %>
</section>
<% if !older.empty? %>
<a class="older" href="<%= older %>">Show older chirps</a>
<% end %>
