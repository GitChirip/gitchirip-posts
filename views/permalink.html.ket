---
params: [base: String, parent: String, card: Card, likes: Integer, replies: String, sha: String]
---
<header class="bar">
  <a class="back" href="<%= base %>/" title="Back">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 5.5 4.5 12l6.5 6.5" /></svg>
  </a>
  <div><h1>Chirp</h1></div>
</header>
<section class="feed thread">
<%== parent %>
  <article class="focus" id="c<%= card.number %>">
    <header>
      <a href="<%= card.profileHref %>"><img class="avatar" src="<%= card.avatar %>" alt="" width="40" height="40"></a>
      <a class="who" href="<%= card.profileHref %>"><strong><%= card.displayName %></strong><span>@<%= card.login %></span></a>
    </header>
    <% if !card.replyToHref.empty? %>
    <p class="context">Replying to <a href="<%= card.replyToHref %>">@<%= card.replyToLogin %></a></p>
    <% end %>
    <p class="text"><%== card.html %></p>
    <p class="stamp"><time datetime="<%= card.publishedAt %>" data-format="full"><%= card.publishedLabel %></time> · <a href="<%= card.commitUrl %>"><code><%= sha %></code></a></p>
    <p class="stats"><a class="likes" href="<%= card.pullUrl %>" target="_blank" rel="noopener" data-number="<%= card.number %>"><strong class="count"><%= likes %></strong> Likes</a> <span><strong><%= card.replies %></strong> Replies</span></p>
    <footer class="actions wide">
      <a class="action like" href="<%= card.pullUrl %>" target="_blank" rel="noopener" title="Like it with a reaction on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.5s-7-4.3-8.8-8.3C2 8.4 3.8 5 7 5c2.1 0 3.6 1.3 5 3.2C13.4 6.3 14.9 5 17 5c3.2 0 5 3.4 3.8 6.2-1.8 4-8.8 8.3-8.8 8.3z" /></svg>
      </a>
      <a class="action commit" href="<%= card.commitUrl %>" title="The commit">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" /><path d="M2.5 12h6M15.5 12h6" /></svg>
      </a>
    </footer>
  </article>
  <section class="compose reply">
    <div class="avatar ghost"></div>
    <p class="command">Reply from your terminal: <code>git chirp reply <%= sha %> "…"</code></p>
  </section>
<%== replies %>
</section>
